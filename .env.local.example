# Copy to .env.local and adjust if needed.
# The officer "Sync Resident Master" button reads RESIDENT_MASTER_CSV_URL first.

RESIDENT_MASTER_CSV_URL="https://docs.google.com/spreadsheets/d/1AqK5Vnpi63Hk8K3AYAhZ5fjtMF-V_LR7u7wzDeE1Ms0/export?format=csv&gid=0"

# Optional fallback when RESIDENT_MASTER_CSV_URL is not set:
# RESIDENT_MASTER_CSV_PATH=$HOME/Downloads/resident_details.csv

# Election backup Google Sheets (runs inside the API process when configured):
# Personal Gmail folders cannot use a service account anymore (Google gives them 0 storage).
# 1. Google Cloud → Credentials → Create OAuth client → Application type: Desktop app
# 2. Put that Desktop client ID/secret in .env.local:
#    GOOGLE_DRIVE_OAUTH_CLIENT_ID=
#    GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
# 3. On that Desktop OAuth client, add redirect URI: http://127.0.0.1:8765
#    (and optionally http://localhost:8765)
# 4. Run: .venv/bin/python3.14 scripts/authorize_google_drive_backup.py
# 5. Paste the printed GOOGLE_DRIVE_REFRESH_TOKEN below.
# ELECTION_BACKUP_DRIVE_FOLDER_ID=
